{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "Site/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/uv/(.*)",
      "dest": "index.js"
    },
    {
      "src": "/(index.html|index.css|js/.*)",
      "dest": "Site/$1"
    },
    {
      "src": "/(.*)",
      "dest": "Site/index.html"
    }
  ]
}
